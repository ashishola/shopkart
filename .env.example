# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Encryption (Generate strong 32+ char secrets in production)
JWT_SECRET=replace_with_64_char_random_jwt_secret
PAYMENT_ENCRYPTION_KEY=replace_with_32_byte_hex_or_passphrase

# MongoDB Atlas (Optional - uses atomic persistent JSON store if unset)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopkart?retryWrites=true&w=majority

# Cloudinary Image Storage (Optional for direct media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Razorpay Account (Can also be managed dynamically in Admin > Payment Settings)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Default Admin Bootstrap (Change immediately after first login)
DEFAULT_SUPER_ADMIN_EMAIL=admin@shopkart.in
DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMeStrong!2026
